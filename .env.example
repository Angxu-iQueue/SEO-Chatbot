# ============================================================================
# Copy this file to .env and fill in the two tokens. Do not put real values
# here — .env.example is committed, .env is gitignored.
#     cp .env.example .env
# ============================================================================

# --- Required -------------------------------------------------------------

# huggingface.co/settings/tokens — fine-grained, with the permission
# "Make calls to Inference Providers"
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# SEOmonitor: Account Settings > Edit Profile > API Token.
# Omit this line to run in knowledge-base-only mode.
SEOMONITOR_API_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...


# --- Model ----------------------------------------------------------------

# Must support tool calling. The suffix picks the provider:
#   :cheapest  lowest price per output token (good default — agents make
#              several round trips per question)
#   :fastest   highest throughput (the default if you omit a suffix)
#   :groq      or any other named provider
# Confirm a model is currently served before relying on it:
#   curl -s https://router.huggingface.co/v1/models -H "Authorization: Bearer $HF_TOKEN"
HF_MODEL=openai/gpt-oss-120b:cheapest

# Max LLM round trips per question. Raise if the bot answers after one tool
# call when the question needed several; each round costs tokens.
MAX_TOOL_ROUNDS=5


# --- Retrieval ------------------------------------------------------------

EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
KB_DIR=knowledge_base

# The abstention threshold. Passages scoring below this are discarded, so the
# bot says "not in the knowledge base" instead of guessing.
#   too many "I don't know"        -> lower toward 0.15
#   invents policy you never wrote -> raise toward 0.40
# Change this only after running eval_retrieval.py.
KB_MIN_RELEVANCE=0.25


# --- Optional: uncomment to override defaults ------------------------------

# Chunking. Rebuild the index after changing either.
#   KB_CHUNK_CHARS=1200
#   KB_CHUNK_OVERLAP=180
#   KB_INDEX_DIR=.kb_index

# Cache TTL in seconds. Rank data updates daily, so this can be generous —
# it is what keeps an interactive session inside the 10k/day API quota.
#   SEOMONITOR_CACHE_TTL=900

# Endpoints. You should not need to touch these.
#   HF_BASE_URL=https://router.huggingface.co/v1
#   SEOMONITOR_BASE_URL=https://apigw.seomonitor.com/v3

# App
#   PORT=7860
#   LOG_LEVEL=INFO

# Set to true to run without an SEOmonitor account (fabricated sample data)
USE_MOCK_SEO=false

# --- Deployment -----------------------------------------------------------

# Set both to require a login. Do this for anything reachable by others.
#   APP_USER=team
#   APP_PASSWORD=change-me

# 127.0.0.1 (default) binds to localhost only. Hugging Face Spaces needs
# 0.0.0.0 — set it there, not on your laptop.
#   HOST=0.0.0.0
